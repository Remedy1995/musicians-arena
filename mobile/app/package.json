{
  "name": "musicians-arena-mobile",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@expo-google-fonts/ibm-plex-sans": "^0.4.1",
    "@expo-google-fonts/sora": "^0.4.2",
    "@expo/metro-runtime": "~56.0.15",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "expo": "~56.0.11",
    "expo-document-picker": "~56.0.4",
    "expo-font": "~56.0.6",
    "expo-image-picker": "~56.0.17",
    "expo-linear-gradient": "~56.0.4",
    "expo-status-bar": "~56.0.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "web:export": "expo export --platform web",
    "eas:login": "npx eas-cli@latest login",
    "eas:whoami": "npx eas-cli@latest whoami",
    "build:android:preview": "npx eas-cli@latest build --platform android --profile preview",
    "build:android:preview:clean": "npx eas-cli@latest build --platform android --profile preview --clear-cache",
    "build:ios:preview": "npx eas-cli@latest build --platform ios --profile preview",
    "build:android:production": "npx eas-cli@latest build --platform android --profile production",
    "build:ios:production": "npx eas-cli@latest build --platform ios --profile production",
    "typecheck": "tsc --noEmit",
    "expo:config": "expo config --type public"
  },
  "private": true
}
